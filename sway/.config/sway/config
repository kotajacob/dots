set $mod Mod4
set $left h
set $down j
set $up k
set $right l

font pango:Berkeley Mono Bold 9

# outputs
set $laptop eDP-1
bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable
output $laptop scale 1.5

set $dock DP-2
output $dock {
	scale 2
}

output * bg #6867ab solid_color

# disable monitor after 15 minutes of inactivity
exec swayidle -w \
	timeout 900 '/home/kota/.local/bin/trysleep.sh' \
	resume 'swaymsg "output * dpms on"'


# inputs
input "type:keyboard" {
	xkb_layout us
	xkb_file /home/kota/.config/sway/keymap.xkb
	repeat_delay 350
	repeat_rate 40
}

input "type:pointer" {
	accel_profile "flat"
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    tap_button_map lmr
    middle_emulation enabled
    natural_scroll enabled
}

# swipe gesture bindings
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next
bindgesture swipe:3:down exec --no-startup-id /home/kota/.local/bin/notabar < /home/kota/.config/notabar/all
bindgesture swipe:3:up exec /home/kota/bin/launcher

# start a terminal
bindsym $mod+Return exec nice -n -5 foot
bindsym $mod+Shift+Return exec nice -n -5 foot -o app-id="foot-float"

# kill focused window
bindsym $mod+Backspace kill

# start your launcher
bindsym $mod+d exec /home/kota/bin/launcher

# start a browser
bindsym $mod+b exec librewolf

# floating mod
floating_modifier $mod

# reload the configuration
bindsym $mod+Shift+c reload

# brightness
bindsym --locked XF86MonBrightnessDown exec /home/kota/.local/bin/lumactl set -- -2%
bindsym --locked XF86MonBrightnessUp exec /home/kota/.local/bin/lumactl set -- +2%

# volume
bindsym XF86AudioRaiseVolume exec pamixer -ui 2
bindsym XF86AudioLowerVolume exec pamixer -ud 2
bindsym XF86AudioMute exec pamixer --toggle-mute

# music
bindsym XF86AudioNext exec mpc next
bindsym XF86AudioPrev exec mpc prev
bindsym XF86AudioPlay exec mpc toggle

# screenshots
bindsym $mod+s exec grimshot --notify copy output
bindsym $mod+Shift+s exec grimshot --notify copy area
bindsym Print exec grimshot --notify copy output
bindsym Shift+Print exec grimshot --notify copy area

# info notification
bindsym $mod+n exec --no-startup-id /home/kota/.local/bin/notabar < /home/kota/.config/notabar/all

# airplane mode
bindsym XF86RFKill exec --no-startup-id /home/kota/.local/bin/notabar < /home/kota/.config/notabar/airplane

# dismiss notifications
bindsym Control+space exec --no-startup-id dunstctl close
bindsym Control+Shift+space exec --no-startup-id dunstctl close-all

# emoji selection
bindsym $mod+m exec --no-startup-id /home/kota/bin/emoji

# exit
bindsym $mod+Shift+Backspace exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -b 'Yes, exit sway' 'swaymsg exit'

# change focus
bindsym $mod+$left exec /home/kota/bin/vim-sway-nav left
bindsym $mod+$down exec /home/kota/bin/vim-sway-nav down
bindsym $mod+$up exec /home/kota/bin/vim-sway-nav up
bindsym $mod+$right exec /home/kota/bin/vim-sway-nav right

# move focused window
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# resize the focused window
set $distance 10
bindsym $mod+Control+$left resize shrink width $distance px
bindsym $mod+Control+$down resize grow height $distance px
bindsym $mod+Control+$up resize shrink height $distance px
bindsym $mod+Control+$right resize grow width $distance px
bindsym $mod+Control+x move absolute position center

# switch to workspace
bindsym $mod+a workspace back_and_forth
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+q workspace number 1
bindsym $mod+w workspace number 2
bindsym $mod+e workspace number 3
bindsym $mod+r workspace number 4
bindsym $mod+t workspace number 5
bindsym $mod+y workspace number 6
bindsym $mod+u workspace number 7
bindsym $mod+i workspace number 8
bindsym $mod+o workspace number 9
bindsym $mod+p workspace number 10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Shift+q move container to workspace number 1
bindsym $mod+Shift+w move container to workspace number 2
bindsym $mod+Shift+e move container to workspace number 3
bindsym $mod+Shift+r move container to workspace number 4
bindsym $mod+Shift+t move container to workspace number 5
bindsym $mod+Shift+y move container to workspace number 6
bindsym $mod+Shift+u move container to workspace number 7
bindsym $mod+Shift+i move container to workspace number 8
bindsym $mod+Shift+o move container to workspace number 9
bindsym $mod+Shift+p move container to workspace number 10

# split in horizontal orientation
bindsym $mod+x split h

# split in vertical orientation
bindsym $mod+z split v

# fullscreen mode
bindsym $mod+f fullscreen toggle

# change container layout (tabbed, toggle split)
bindsym $mod+c layout toggle tabbed split

# toggle tiling / floating
bindsym $mod+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+Shift+space focus mode_toggle

## borders
default_border pixel 2
default_floating_border pixel 2
smart_borders no_gaps

## gaps
gaps inner 8
smart_gaps on

### primary color
set $pc #545499
### light primary color
set $lc #9596de
### urgent color
set $uc #E4943A
### font color
set $fc #FFFFFF

## bar
bar {
	position top
	status_command /home/kota/.local/bin/swaybar-commander
	tray_output none
	wrap_scroll yes
	separator_symbol " "
	colors {
		statusline $fc
		background $pc
		separator $pc
		focused_workspace $pc $pc $fc
		active_workspace $pc $pc $lc
		inactive_workspace $pc $pc $lc
		urgent_workspace $pc $pc $uc
	}
}

### class					border	back	text	indicator	child_border
client.focused				$pc		$pc		$fc		$pc			$lc
client.focused_inactive		$fc		$fc		$pc		$fc			$pc
client.unfocused			$fc    	$fc		$pc		$fc			$pc
client.urgent				$uc		$uc		$pc		$uc			$uc
client.placeholder			$pc    	$pc		$pc		$pc			$pc
client.background			$pc

# wait a bit before removing urgency hint from windows/workspaces
force_display_urgency_hint 750 ms

# program overrides
# use swaymsg -t get_tree
for_window [shell="xwayland"] floating enable
for_window [app_id="foot-float"] floating enable
for_window [app_id="imv"] floating enable
for_window [app_id="imv"] resize set 640px 360px
for_window [app_id="imv" title=".*aart.*"] resize set 360px 360px
for_window [app_id="thunderbird" title=".*Reminder"] floating enable
for_window [app_id="thunderbird" title=".*Reminder"] resize set 360px 360px
for_window [app_id="imv"] border pixel 3
for_window [app_id="mpv"] floating enable
for_window [app_id="mpv"] resize set 1280px 720px
for_window [app_id="mpv"] inhibit_idle fullscreen
for_window [app_id="firefox"] inhibit_idle fullscreen
for_window [title="Firefox — Sharing Indicator"] floating enable
for_window [title="Firefox — Sharing Indicator"] kill
for_window [shell="xwayland"] title_format "[XWayland] %title"
for_window [title="TETROBUST"] floating enable

# set variables for dbus
exec --no-startup-id exec dbus-update-activation-environment --all

# start user services
exec openrc -U gui

# start dunst
exec --no-startup-id dunst

# cursor
seat seat0 xcursor_theme capitaine-cursors-dark 24
exec_always gsettings set org.gnome.desktop.interface cursor-theme "capitaine-cursors-dark"
exec_always gsettings set org.gnome.desktop.interface cursor-size 24
