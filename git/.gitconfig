[user]
	email = kota@nilsu.org
	name = Dakota Walsh
	signingkey = ~/.ssh/id_rsa.pub
[sendemail]
	smtpserver = smtp.migadu.com
	smtpuser = kota@nilsu.org
	smtpencryption = ssl
	smtpserverport = 465
[color]
	ui = auto
[alias]
	aa = add --all
	st = status
	ci = commit --verbose
	br = branch
	sw = switch
	co = checkout
	ff = merge --ff-only
	ra = log --oneline --graph --decorate --all
	raa = log --oneline
	di = diff
	dc = diff --cached
	amend = commit --amend
	fa = fetch --all
	ps = push
	pl = pull
	dh1 = diff HEAD~1
	hard = reset --hard FETCH_HEAD
[init]
	defaultBranch = main
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[diff]
	algorithm = histogram # better than the default of myers
	colorMoved = plain # colors moved lines different than added / deleted
	mnemonicPrefix = true # i/ (index), w/ (working), c/ (commit) instead of a/ b/
	renames = true
[commit]
	gpgsign = true
[gpg]
	program = gpg2
	format = ssh
[core]
	excludesfile = ~/.gitignore_global
[pager]
	log = diff-highlight | less -FRX --mouse
	show = diff-highlight | less -FRX --mouse
	diff = diff-highlight | less -FRX --mouse
	branch = cat
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
